{
    "version": "0.2.0",
    "configurations": [
        {
            // Full cycle: build -> program over SWD -> stop at main.
            "name": "Flash and debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/AstraNRF/zephyr/zephyr.elf",
            "device": "nRF52840_xxAA",
            "configFiles": [
                "interface/stlink.cfg",
                "target/nordic/nrf52.cfg"
            ],
            "interface": "swd",
            "toolchainPrefix": "arm-zephyr-eabi",
            "armToolchainPath": "C:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin",
            "gdbPath": "C:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe",
            "serverpath": "C:/Users/Juice/AppData/Local/Microsoft/WinGet/Packages/xpack-dev-tools.openocd-xpack_Microsoft.Winget.Source_8wekyb3d8bbwe/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "runToEntryPoint": "main",
            "preLaunchTask": "nRF Connect: Build"
        },
        {
            "name": "Debug (no flash)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/AstraNRF/zephyr/zephyr.elf",
            "device": "nRF52840_xxAA",
            "configFiles": [
                "interface/stlink.cfg",
                "target/nordic/nrf52.cfg"
            ],
            "interface": "swd",
            "toolchainPrefix": "arm-zephyr-eabi",
            "armToolchainPath": "C:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin",
            "gdbPath": "C:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe"
        }
    ]
}