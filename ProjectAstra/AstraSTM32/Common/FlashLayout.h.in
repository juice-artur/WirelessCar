#ifndef ASTRA_FLASH_LAYOUT_H
#define ASTRA_FLASH_LAYOUT_H

/*
 * STM32G431CBT6 Flash layout.
 *
 * Generated from Common/FlashLayout.cmake.  Do not edit this file directly.
 *
* 0x08000000 +---------------+
 *             | Bootloader    | 24 KiB
 * 0x08006000 +---------------+
 *             | App header    | 2 KiB (one complete Flash page)
 * 0x08006800 +---------------+
 *             | Application   | 98 KiB max
 * 0x0801F000 +---------------+
 *             | Metadata A    | 2 KiB
 * 0x0801F800 +---------------+
 *             | Metadata B    | 2 KiB
 * 0x08020000 +---------------+
 */

#include <stdint.h>

/* Entire device memory */
#define FLASH_BASE_ADDR              @FLASH_BASE_ADDR@UL
#define FLASH_SIZE_BYTES             @FLASH_SIZE_BYTES@UL
#define FLASH_END_ADDR               @FLASH_END_ADDR@UL
#define FLASH_LAYOUT_PAGE_SIZE        @FLASH_LAYOUT_PAGE_SIZE@UL
#define FLASH_LAYOUT_PAGE_COUNT       @FLASH_LAYOUT_PAGE_COUNT@UL
#define RAM_ORIGIN                    @RAM_ORIGIN@UL
#define RAM_LENGTH                    @RAM_LENGTH@UL
#define VECTOR_TABLE_ALIGNMENT        @VECTOR_TABLE_ALIGNMENT@UL

/* Bootloader: Flash pages 0..11 */
#define BOOTLOADER_START_ADDR        @BOOTLOADER_START_ADDR@UL
#define BOOTLOADER_SIZE              @BOOTLOADER_SIZE@UL
#define BOOTLOADER_END_ADDR          @BOOTLOADER_END_ADDR@UL
#define BOOTLOADER_PAGE_COUNT         @BOOTLOADER_PAGE_COUNT@UL

/* Application slot: header + executable image */
#define APP_SLOT_START_ADDR          @APP_SLOT_START_ADDR@UL
#define APP_HEADER_ADDR              @APP_HEADER_ADDR@UL
#define APP_HEADER_SIZE              @APP_HEADER_SIZE@UL
#define APP_HEADER_END_ADDR          @APP_HEADER_END_ADDR@UL

/* Vector table and executable application start here */
#define APP_START_ADDR               @APP_START_ADDR@UL
#define APP_VECTOR_TABLE_ADDR        @APP_VECTOR_TABLE_ADDR@UL
/* VTOR offset is relative to FLASH_BASE_ADDR. */
#define APP_VECTOR_TABLE_OFFSET      @APP_VECTOR_TABLE_OFFSET@UL

/* Redundant metadata pages at the end of Flash */
#define META_PAGE_SIZE               @META_PAGE_SIZE@UL
#define META_A_START_ADDR            @META_A_START_ADDR@UL
#define META_B_START_ADDR            @META_B_START_ADDR@UL
#define FLASH_METADATA_END_ADDR      @FLASH_METADATA_END_ADDR@UL

/* Application ends immediately before Metadata A */
#define APP_SLOT_END_ADDR            @APP_SLOT_END_ADDR@UL
#define APP_SLOT_SIZE                @APP_SLOT_SIZE@UL

/* Maximum code size excludes the reserved application header */
#define APP_MAX_CODE_SIZE            @APP_MAX_CODE_SIZE@UL

/* Maximum complete image size includes the reserved header */
#define APP_MAX_IMAGE_SIZE           @APP_MAX_IMAGE_SIZE@UL

/* Layout consistency checks */
_Static_assert(FLASH_BASE_ADDR == 0x08000000UL,
               "Unexpected STM32G431 Flash base address");
_Static_assert(FLASH_SIZE_BYTES == (128UL * 1024UL),
               "Unexpected STM32G431 Flash size");
_Static_assert(FLASH_END_ADDR == 0x08020000UL,
               "Unexpected STM32G431 Flash end address");
_Static_assert(FLASH_LAYOUT_PAGE_SIZE == 0x800UL,
               "Unexpected STM32G431 Flash page size");
_Static_assert(FLASH_LAYOUT_PAGE_COUNT == 64UL,
               "Unexpected STM32G431 Flash page count");
_Static_assert(RAM_ORIGIN == 0x20000000UL,
               "Unexpected STM32G431 RAM origin");
_Static_assert(RAM_LENGTH == (32UL * 1024UL),
               "Unexpected STM32G431 RAM length");

_Static_assert(BOOTLOADER_START_ADDR == FLASH_BASE_ADDR,
               "Bootloader must start at the beginning of Flash");
_Static_assert(BOOTLOADER_SIZE == (24UL * 1024UL),
               "Unexpected bootloader size");
_Static_assert(BOOTLOADER_SIZE % FLASH_LAYOUT_PAGE_SIZE == 0UL,
               "Bootloader size must be page aligned");
_Static_assert(BOOTLOADER_PAGE_COUNT == 12UL,
               "Unexpected bootloader page count");
_Static_assert(BOOTLOADER_END_ADDR == APP_HEADER_ADDR,
               "Application header must follow bootloader");

_Static_assert(APP_HEADER_ADDR == 0x08006000UL,
               "Unexpected application header address");
_Static_assert(APP_HEADER_SIZE == FLASH_LAYOUT_PAGE_SIZE,
               "Application header must occupy one complete Flash page");
_Static_assert(APP_HEADER_ADDR % FLASH_LAYOUT_PAGE_SIZE == 0UL,
               "Application header must be page aligned");
_Static_assert(APP_HEADER_END_ADDR == APP_START_ADDR,
               "Application start must follow the header");
_Static_assert(APP_START_ADDR == 0x08006800UL,
               "Unexpected application start address");
_Static_assert(APP_VECTOR_TABLE_ADDR == APP_START_ADDR,
               "Application vector table must be at application start");
_Static_assert(APP_VECTOR_TABLE_OFFSET == 0x00006800UL,
               "Unexpected application vector-table offset");
_Static_assert((APP_VECTOR_TABLE_OFFSET % VECTOR_TABLE_ALIGNMENT) == 0UL,
               "Application vector table must be suitably aligned");

_Static_assert(APP_SLOT_END_ADDR == META_A_START_ADDR,
               "Application slot must end at Metadata A");
_Static_assert(APP_SLOT_END_ADDR == 0x0801F000UL,
               "Unexpected application slot end address");
_Static_assert(APP_SLOT_SIZE == 0x19000UL,
               "Unexpected application slot size");
_Static_assert(APP_MAX_CODE_SIZE == 0x18800UL,
               "Unexpected maximum application code size");
_Static_assert(APP_MAX_IMAGE_SIZE == APP_SLOT_SIZE,
               "Maximum image size must include the application header");
_Static_assert(APP_START_ADDR < APP_SLOT_END_ADDR,
               "Application start is outside the application slot");

_Static_assert(META_PAGE_SIZE == FLASH_LAYOUT_PAGE_SIZE,
               "Metadata page size must match Flash page size");
_Static_assert(META_A_START_ADDR % FLASH_LAYOUT_PAGE_SIZE == 0UL,
               "Metadata A must be page aligned");
_Static_assert(META_A_START_ADDR == 0x0801F000UL,
               "Unexpected Metadata A address");
_Static_assert(META_B_START_ADDR == META_A_START_ADDR + META_PAGE_SIZE,
               "Metadata pages must be adjacent");
_Static_assert(META_B_START_ADDR == 0x0801F800UL,
               "Unexpected Metadata B address");
_Static_assert(FLASH_METADATA_END_ADDR == FLASH_END_ADDR,
               "Metadata must end at the end of Flash");

#endif /* ASTRA_FLASH_LAYOUT_H */
